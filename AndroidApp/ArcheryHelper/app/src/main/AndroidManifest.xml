<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    
    <application
        android:name=".managers.Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="false"
        android:theme="@style/Theme.ArcheryHelper">
        <activity
            android:name=".activities.DetailedStatisticsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.StatisticsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ManualInputActivity"
            android:exported="false" />
        <activity
            android:name=".activities.EditActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ScanActivity"
            android:exported="false" />
        <activity
            android:name=".activities.DistanceActivity"
            android:exported="false" />
        <activity
            android:name=".activities.NewDistanceActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MainMenuActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>