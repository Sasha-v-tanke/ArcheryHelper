<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <TextView
        android:id="@+id/distanceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Дистанция: 50м"
        android:gravity="center" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/seriesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:scrollbars="horizontal|vertical" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:layout_marginBottom="50dp"
        android:gravity="center"
        android:text="Пусто"
        android:textAlignment="center"
        android:textSize="30sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/seriesSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sum: 100"
            android:layout_weight="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/seriesAvg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Average: 10.4"
            android:layout_weight="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/seriesCnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Count: 15"
            android:layout_weight="1"
            android:gravity="center" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAddSeries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить серию"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnCurrentStatistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Показать статистику"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSaveDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить дистанцию"
        android:layout_marginTop="8dp" />

</LinearLayout>